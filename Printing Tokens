#include <stdio.h>
#include <string.h>
#include <stdlib.h>

int main() {
    char *s = malloc(1024 * sizeof(char));
    
    if (scanf("%[^\n]", s) != 1) {
        free(s);
        return 0;
    }
    char *word = strtok(s, " ");
    while (word != NULL) {
        printf("%s\n", word);
        word = strtok(NULL, " ");
    }
    
    free(s);
    return 0;
}
