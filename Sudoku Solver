#include <stdbool.h>
int rows[9] = {0};
int cols[9] = {0};
int boxes[9] = {0};

bool solve(char** board, int cell) {
    if (cell == 81) return true;

    int r = cell / 9;
    int c = cell % 9;
    int box_idx = (r / 3) * 3 + (c / 3);

    if (board[r][c] != '.') {
        return solve(board, cell + 1);
    }

    for (int num = 0; num < 9; num++) {
        int mask = 1 << num;

        if (!(rows[r] & mask) && !(cols[c] & mask) && !(boxes[box_idx] & mask)) {
            
        
            board[r][c] = num + '1';
            rows[r] |= mask;
            cols[c] |= mask;
            boxes[box_idx] |= mask;

          
            if (solve(board, cell + 1)) return true;

            
            board[r][c] = '.';
            rows[r] &= ~mask;
            cols[c] &= ~mask;
            boxes[box_idx] &= ~mask;
        }
    }

    return false;
}

void solveSudoku(char** board, int boardSize, int* boardColSize) {
    for (int i = 0; i < 9; i++) {
        rows[i] = 0;
        cols[i] = 0;
        boxes[i] = 0;
    }
    for (int r = 0; r < 9; r++) {
        for (int c = 0; c < 9; c++) {
            if (board[r][c] != '.') {
                int num = board[r][c] - '1';
                int mask = 1 << num;
                int box_idx = (r / 3) * 3 + (c / 3);
                
                rows[r] |= mask;
                cols[c] |= mask;
                boxes[box_idx] |= mask;
            }
        }
    }
    solve(board, 0);
}
