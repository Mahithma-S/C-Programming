#include <stdio.h>

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;
    
    int size = 2 * n - 1;
    for (int i = 0; i < size; i++) {
        for (int j = 0; j < size; j++) {
            int top = i;
            int bottom = size - 1 - i;
            int left = j;
            int right = size - 1 - j;
            
            // Find the minimum distance
            int min = top;
            if (bottom < min) min = bottom;
            if (left < min) min = left;
            if (right < min) min = right;
            printf("%d", n - min);
            if (j < size - 1) {
                printf(" ");
            }
        }
        printf("\n");
    }
    return 0;
}
