#include <stdio.h>
#include <string.h>

int main() {
    char s[1001];
    int freq[10] = {0}; 
    
    if (scanf("%1000s", s) == 1) {
        
        for (int i = 0; s[i] != '\0'; i++) {
            if (s[i] >= '0' && s[i] <= '9') {
                freq[s[i] - '0']++; 
            }
        }
        
        for (int i = 0; i < 10; i++) {
            printf("%d ", freq[i]);
        }
        printf("\n");
    }
    
    return 0;
}
